{
  "name": "@yomitan-core/web",
  "version": "2.0.0",
  "description": "Browser adapters for yomitan-core: IndexedDB storage with Yomitan's schema, the <yomitan-entries> element, and a web worker host.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/louismollick/yomitan-core.git",
    "directory": "packages/web"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "yomitan-core": "2.0.0"
  },
  "devDependencies": {
    "fake-indexeddb": "6.0.0"
  }
}
