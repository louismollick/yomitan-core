{
  "branches": [
    "main",
    "master"
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "verifyConditionsCmd": "node scripts/release/publish.mjs --check",
        "prepareCmd": "node scripts/release/set-version.mjs ${nextRelease.version} && npm install --package-lock-only --ignore-scripts && npm run build && node scripts/release/install-smoke.mjs",
        "publishCmd": "node scripts/release/publish.mjs --tag latest"
      }
    ],
    "@semantic-release/github",
    [
      "@semantic-release/git",
      {
        "assets": [
          "packages/*/package.json",
          "package-lock.json",
          "CHANGELOG.md"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ]
  ]
}
