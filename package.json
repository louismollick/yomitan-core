{
  "name": "yomitan-core-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/node",
    "packages/react-native",
    "packages/contract-tests"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "verify": "npm run build && npm run typecheck && npm run lint && npm run test",
    "sync-upstream": "npm run sync-upstream -w yomitan-core",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "tsdown": "^0.15.12",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "allowScripts": {
    "esbuild@0.27.3": true,
    "esbuild@0.25.12": true,
    "better-sqlite3@12.11.1": true
  }
}
